# Yahoo Finance Chart uses server-side requests without an API key.
# Market data does not require a key. These market provider fields remain reserved.
MARKET_DATA_API_KEY=
MARKET_DATA_API_BASE_URL=
# Phase 2B only: server-side OpenAI key; never use a NEXT_PUBLIC_ prefix.
# Leave blank to keep news working with AI analysis unavailable.
OPENAI_API_KEY=
# Optional model supporting Chat Completions strict JSON Schema; default gpt-4.1-mini.
NEWS_AI_MODEL=
# Optional successful analyses per Taipei calendar day; blank=50, 0=disable.
# Invalid values disable new analyses. In-flight requests reserve capacity.
NEWS_AI_DAILY_LIMIT=
# Netlify supplies Blobs context automatically. Local dev falls back to process memory.
